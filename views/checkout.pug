extends layout

block content
  section.page-header
    h1 Checkout
    p Enter your information to place your order.

  if success
    div.success-message
      p= success

  section.form-container
    form(action="/checkout", method="POST")
      label(for="name") Full Name
      input(type="text", id="name", name="name", required)

      label(for="email") Email
      input(type="email", id="email", name="email", required)

      label(for="address") Shipping Address
      input(type="text", id="address", name="address", required)

      label(for="city") City
      input(type="text", id="city", name="city", required)

      label(for="payment") Payment Method
      select(id="payment", name="payment", required)
        option(value="", disabled, selected) Select payment method
        option(value="card") Credit/Debit Card
        option(value="paypal") PayPal
        option(value="cash") Cash on Delivery

      button.button(type="submit") Place Order